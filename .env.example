# Copy to .env.local for local dev (`copy .env.example .env.local`).
# On Render, set the same keys in the dashboard (render.yaml uses sync:false).
# Never commit real values — .env and .env*.local are gitignored.

# Optional, web search only (https://serpapi.com)
SERPAPI_KEY=

# Optional, server trial/member chat (Google AI Studio key)
GEMINI_KEY=

# Optional, image generation (https://huggingface.co)
HF_TOKEN=

# Member auth via Google OAuth (Supabase → Settings → API).
# NOTE: NEXT_PUBLIC_* vars bake in at build time — redeploy after changing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
