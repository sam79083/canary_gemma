# Supabase API keys (get from Supabase Dashboard → Settings → API)
# These are SAFE to commit - they're publishable anon keys with RLS enforced
NEXT_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_placeholder

# Optional: site URL for OAuth redirects (change for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000